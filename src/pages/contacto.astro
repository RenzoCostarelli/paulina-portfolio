---
import BaseLayout from "../layouts/BaseLayout.astro";
import PlaceholderImage from "../components/PlaceholderImage.astro";
import { createClient } from "../lib/prismicio";
import { asLink } from "@prismicio/client";

const client = createClient();
const contacto = await client.getSingle("contacto");
const photo = contacto.data.photo;
const instagram = asLink(contacto.data.instagram);
const facebook = asLink(contacto.data.facebook);
---

<BaseLayout title="Contacto — Paulina Scheitlin">
  <div class="flex max-w-sm flex-col gap-6">
    {
      photo.url ? (
        <img src={photo.url} width={photo.dimensions.width} height={photo.dimensions.height} alt={photo.alt ?? "Paulina Scheitlin"} class="w-full" />
      ) : (
        <PlaceholderImage alt="Paulina Scheitlin" ratio="aspect-[4/3]" class="w-full" />
      )
    }
    <div class="flex flex-col gap-1">
      <p class="text-sm font-semibold">Paulina Scheitlin</p>
      <p class="text-sm">Rosario, Santa Fe, Argentina</p>
    </div>
    {
      contacto.data.phone && (
        <a href={`tel:${contacto.data.phone}`} class="w-fit text-sm underline">
          {contacto.data.phone}
        </a>
      )
    }
    {
      (contacto.data.email || instagram || facebook) && (
        <div class="flex items-center gap-4">
          {contacto.data.email && (
            <a href={`mailto:${contacto.data.email}`} aria-label="Email" class="text-black">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path d="m3 7 9 6 9-6" />
              </svg>
            </a>
          )}
          {instagram && (
            <a href={instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="text-black">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" stroke="none" />
              </svg>
            </a>
          )}
          {facebook && (
            <a href={facebook} target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="text-black">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                <path d="M15 8h-2a2 2 0 0 0-2 2v2H9v3h2v6h3v-6h2.2l.3-3H14v-1.5c0-.6.4-1 1-1h1.5V8Z" />
              </svg>
            </a>
          )}
        </div>
      )
    }
  </div>
</BaseLayout>
